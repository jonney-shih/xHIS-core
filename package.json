{
  "name": "xhis-core-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "xHIS-core workspace root: the deterministic execution core (packages/xhis-core) and its sibling packages",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "benchmark": "npm run benchmark --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.0.5"
  }
}
